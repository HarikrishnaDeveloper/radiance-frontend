{
  "expo": {
    "name": "Radiance",
    "slug": "radiance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./logo_square.png",
    "scheme": "radiance",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./logo_splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.hari1014129.radiance",
      "supportsTablet": false,
      "icon": "./logo_square.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "tez",
          "phonepe",
          "paytmmp"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a0040",
        "foregroundImage": "./logo_square.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hari1014129.radiance"
    },
    "web": {
      "output": "static",
      "favicon": "./logo_square.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./logo_splash.png",
          "imageWidth": 280
        }
      ],
      "expo-secure-store",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a43f59f6-d74d-42da-9b4b-4baa9e26579e"
      }
    }
  }
}
